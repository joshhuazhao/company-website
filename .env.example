# Database password for PostgreSQL (generate a strong one: openssl rand -base64 24)
DB_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# Firebase Admin credentials (required by the api container)
#
# RECOMMENDED - use a key file instead of pasting JSON into this file:
#   1. Firebase Console > Project settings > Service accounts > Generate new private key
#   2. Save the downloaded file as ./firebase-service-account.json
#   3. In docker-compose.yml, uncomment the volume line that mounts it into
#      the api container at /secrets/firebase-service-account.json
#   4. Set the path below and leave FIREBASE_SERVICE_ACCOUNT_JSON empty
FIREBASE_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json

# ALTERNATIVE - paste the entire downloaded JSON as ONE single line below
# (single-quote it; keep the \n escapes inside private_key exactly as
# downloaded). Do NOT use this placeholder - it is redacted and will fail:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"leanjust-website","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@leanjust-website.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'
